<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, GitHub Packages and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-viewer</artifactId>
	<version>1.0.0</version>
	<name>Parley Files Viewer</name>
	<description>A Swing application for browsing, copying, searching and editing files on any
		parley-files file system (local, memory, FTP, SFTP, JDBC). Formerly
		com.bringardner:bjl_file_system_viewer (BjlFileSystemViewer).</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.viewer</parley.moduleName>
		<flatlaf.version>3.5.4</flatlaf.version>
		<jna.version>5.19.1</jna.version>
	</properties>

	<profiles>
		<!-- Native binary named parley-files-viewer: mvn -Pnative package -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>parley-files-viewer</imageName>
							<mainClass>us.bringardner.parley.files.viewer.FileSourceViewer</mainClass>
							<buildArgs>
								<!-- fsh (a dependency) ships native-image.properties with -Djava.awt.headless=true; this is a window app -->
								<buildArg>-Djava.awt.headless=false</buildArg>
								<!-- Cp1252 etc.: JNA looks the platform charset up by name -->
								<buildArg>-H:+AddAllCharsets</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
					<!-- AWT reads its font configuration from java.home/lib, and the image's java.home is
					     its own folder (see FileSourceViewer.main): ship the JDK's file beside the exe -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>native-fontconfig</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${java.home}/lib</directory>
											<includes>
												<include>fontconfig.bfc</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- The Parley app icon for the windows and the Dock -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-brand</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- DynamicTrustManager and VisualCertificateValidator; was bjl_net_framework -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<!-- the file chooser, connection dialog, drag and drop and progress monitor -->
			<artifactId>parley-files-swing</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- brings its own maintained JSch (same com.jcraft.jsch packages), so the old
		     com.jcraft:jsch 0.1.54 is no longer listed here -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- parley-files-sftp has no SSH library of its own: the provider for Parley's own one, which it
		     prefers when it's there (JSch or MINA could be added instead) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp-parley-ssh</artifactId>
			<version>1.0.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-jdbc</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- DateTimeCombo in the search window; was bjl_core's us.bringardner.core.swing -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-swing-widgets</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- The "Open terminal" action uses fsh's Console; was bjl_shell (BjlShell) -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-intellij-themes</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-extras</artifactId>
			<version>${flatlaf.version}</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-fonts-inter</artifactId>
			<version>4.0</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-fonts-jetbrains-mono</artifactId>
			<version>2.304</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-fonts-roboto</artifactId>
			<version>2.137</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf-fonts-roboto-mono</artifactId>
			<version>3.000</version>
		</dependency>
		<dependency>
			<groupId>com.miglayout</groupId>
			<artifactId>miglayout-swing</artifactId>
			<version>11.4.2</version>
		</dependency>

		<!-- macOS only, at run time: the applications that handle a file (registry.LaunchServices),
		     through Core Foundation and Launch Services. Replaces a JNI library built with Xcode. -->
		<dependency>
			<groupId>net.java.dev.jna</groupId>
			<artifactId>jna</artifactId>
			<version>${jna.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
